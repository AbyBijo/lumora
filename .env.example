# ── Lumora environment ────────────────────────────────────────────────
# Copy to BOTH .env.local (Next.js reads this) and .env (Prisma CLI and
# tsx scripts read this). The app runs fully in "local engine" mode with
# no keys — LLM keys upgrade generation quality.

# Database
# Local dev: SQLite (default). For production switch to PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/lumora"
DATABASE_URL="file:./dev.db"

# Public origin of the app (used for absolute links, CSRF origin checks).
# e.g. APP_URL="https://lumora.example.com"
APP_URL="http://localhost:3000"

# Cookies: force `Secure` on the session cookie in production. Set to
# "false" only if you terminate TLS behind a plain-HTTP proxy.
# COOKIE_SECURE="true"

# Optional LLM keys (model-agnostic gateway — any provider you enable is used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model per provider (optional overrides)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
NEXT_PUBLIC_APP_NAME=Lumora

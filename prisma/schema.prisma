// ─────────────────────────────────────────────────────────────────────────────
// Lumora — Prisma schema
// Dev default: SQLite (runs anywhere, zero setup). Production: PostgreSQL —
// change `provider` to "postgresql" and set a Postgres DATABASE_URL, then
// `npx prisma db push` (or migrate). No schema changes are required: the data
// model is portable.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  /// Argon2id/bcrypt hash — never stored in plaintext.
  passwordHash   String
  /// Set when the email has been verified (Phase 2+; reserved column).
  emailVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  settings       UserSettings?
  sessions       Session[]
  documents      Document[]
  curricula      Curriculum[]
  progress       UserProgress[]
  mastery        MasteryRecord[]
  flashcards     Flashcard[]
  reviewLogs     ReviewLog[]
  studySessions  StudySession[]
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme    String @default("dark") // dark | light
  provider String @default("local") // local | openai | anthropic
  model    String @default("")
  streakGoalDays Int @default(7)
}

/// Server-side sessions. The cookie holds a random opaque token; only its
/// SHA-256 hash is stored here, so a database leak does not leak sessions.
/// Sessions can be revoked (logout / password change) and expire.
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  ip           String?
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ── Source documents & traceability ─────────────────────────────────────────

/// An uploaded source (PDF, DOCX, TXT/MD, or a web URL).
model Document {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  fileType   String // pdf | docx | txt | md | url
  status     String        @default("uploaded") // uploaded | processing | ready | failed
  sourceUrl  String?
  error      String?
  /// Structural outline (headings + blocks) as JSON — used by curriculum assembly.
  structure  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  chunks     SourceChunk[]
  curriculum Curriculum?
}

/// A contiguous slice of the source with its location (section/page), so every
/// generated claim can be traced back to the exact passage it came from.
model SourceChunk {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int // position within the document
  text       String
  section    String? // nearest heading, e.g. "2. Memory Encoding"
  page       Int? // page number when known (PDFs)
  startChar  Int?
  endChar    Int?
  lessons    Lesson[]
  concepts   Concept[]
  quizzes    Quiz[]
  flashcards Flashcard[]

  @@index([documentId, index])
}

// ── Curriculum ──────────────────────────────────────────────────────────────

model Curriculum {
  id           String        @id @default(cuid())
  documentId   String        @unique
  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String        @default("draft") // draft | approved
  totalModules Int           @default(0)
  masteryScore Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  modules      Module[]
  flashcards   Flashcard[]
  progress     UserProgress[]
  studySessions StudySession[]
}

model Module {
  id           String   @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  order        Int
  masteryScore Float    @default(0)
  lessons      Lesson[]

  @@unique([curriculumId, order])
}

model Lesson {
  id         String    @id @default(cuid())
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  content    String // lesson body — the guided explanation
  order      Int
  objectives String? // JSON array of learning objectives
  sourceRef  String? // human-readable location, e.g. "§2 · p.3"
  sourceChunkId String?
  sourceChunk   SourceChunk? @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)
  concepts   Concept[]
  quizzes    Quiz[]
  progress   UserProgress[]

  @@unique([moduleId, order])
}

model Concept {
  id            String        @id @default(cuid())
  lessonId      String
  lesson        Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name          String
  definition    String
  sourceRef     String?
  sourceChunkId String?
  sourceChunk   SourceChunk?  @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)
  flashcards    Flashcard[]
  mastery       MasteryRecord[]
}

// ── Assessment ──────────────────────────────────────────────────────────────

/// A generated question. Types: mcq | fill-blank | short-answer
model Quiz {
  id            String        @id @default(cuid())
  lessonId      String
  lesson        Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          String
  question      String
  options       String? // JSON array of choices (mcq)
  answer        String
  explanation   String?
  sourceRef     String?
  sourceChunkId String?
  sourceChunk   SourceChunk?  @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)
  mastery       MasteryRecord[]
  reviewLogs    ReviewLog[]
}

// ── SRS (SM-2) ──────────────────────────────────────────────────────────────

/// A spaced-repetition card. Carries its own SM-2 state.
model Flashcard {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumId    String
  curriculum      Curriculum  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  conceptId       String?
  concept         Concept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  front           String
  back            String
  sourceRef       String?
  sourceChunkId   String?
  sourceChunk     SourceChunk? @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)
  repetitions     Int         @default(0)
  interval        Int         @default(0) // days
  easeFactor      Float       @default(2.5)
  dueDate         DateTime    @default(now())
  lastReviewedAt  DateTime?
  reviewLogs      ReviewLog[]

  @@index([userId, dueDate])
  @@index([curriculumId])
}

// ── Progress, mastery, activity ─────────────────────────────────────────────

/// One row per (user, lesson): completion + rolling quiz score.
model UserProgress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean  @default(false)
  score        Float    @default(0) // 0..1 rolling average
  attempts     Int      @default(0)
  lastStudied  DateTime?

  @@unique([userId, lessonId])
}

/// Per-concept / per-question mastery state.
model MasteryRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId     String?
  concept       Concept?  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  quizId        String?
  quiz          Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score         Float     @default(0) // 0..1
  attempts      Int       @default(0)
  lastAttempted DateTime?
  mastered      Boolean   @default(false)

  @@unique([userId, quizId])
  @@unique([userId, conceptId])
  @@index([userId, mastered])
}

/// Every flashcard rating / quiz answer → feeds streaks + analytics.
model ReviewLog {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String?
  flashcard    Flashcard?  @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  quizId       String?
  quiz         Quiz?       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  kind         String // flashcard | quiz
  rating       String? // again | hard | good | easy (flashcards)
  correct      Boolean?
  reviewedAt   DateTime    @default(now())

  @@index([userId, reviewedAt])
}

/// A study session (lesson, quiz run, flashcard review, cram mode).
model StudySession {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumId   String?
  curriculum     Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  kind           String // lesson | quiz | flashcards | cram
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  itemsCompleted Int         @default(0)
}

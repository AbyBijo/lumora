# ── Lumora environment ────────────────────────────────────────────────
# Copy to .env.local and fill in what you need. The app runs fully in
# "local engine" mode with no keys — LLM keys upgrade generation quality.

# Optional LLM keys (model-agnostic gateway — any provider you enable is used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model per provider (optional overrides)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Database
# Local dev: SQLite (default). For production switch to PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/lumora"
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_NAME=Lumora
